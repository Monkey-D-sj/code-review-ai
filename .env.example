# Model configuration for the review agent. Copy this file to `.env` and fill in
# the values; `.env` is git-ignored. Process environment variables override the
# file. Conventions match code_review_ai/review_agent on master.

# The API key provider will use (name of the env variable holding the key).
OPENAI_API_KEY=

# Model id, e.g. a deepseek reasoning model or an OpenAI-compatible model id.
CRAI_REVIEW_MODEL=

# Optional OpenAI-compatible endpoint (DeepSeek etc. route through their adapter).
# CRAI_BASE_URL=
# CRAI_REVIEW_BASE_URL=
